- id: call_mom
  alias: Call Mom
  description: "Triggered by Kiasbutton MQTT action"

  trigger:
    - platform: mqtt
      topic: zigbee2mqtt/kiasButtons
      value_template: "{{ value_json.action }}"
      value: "1_single"

  condition: []

  action:
    - service: mqtt.publish
      data:
        topic: zigbee2mqtt/alert_lights/set
        payload: '{"state":"ON","brightness":200}'
        qos: 0
        retain: false

  - delay: "00:00:01.5"

  - service: mqtt.publish
    data:
      topic: zigbee2mqtt/alert_lights/set
      payload: '{"state":"OFF"}'
      qos: 0
      retain: false

  - service: shell_command.play_alert

  - service: system_log.write
    data:
      message: "Kiasbutton triggered with action: {{ value_json.action }}"
      level: info

  - service: mqtt.publish
    data:
      topic: buzzgate/alert
      payload: "bathroom_call"
      qos: 0
      retain: false

  mode: single
